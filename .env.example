# Local Docker development. Copy to .env and replace both placeholders.
DB_PASSWORD=replace-with-a-random-database-password
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000

# Running Python directly (Compose supplies these for its backend).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=talentforge
DB_USER=postgres
DB_CONNECT_TIMEOUT=10

# Production: set through the hosting provider's secret manager, not this file.
# DATABASE_URL=postgresql://app_user:URL_ENCODED_PASSWORD@db-host:5432/talentforge
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/run/secrets/postgres-ca.pem
# CORS_ORIGINS=https://your-project.pages.dev,https://your-custom-domain
# FRONTEND_BASE_URL=https://your-project.pages.dev
# VITE_API_URL=https://api.your-domain.example
